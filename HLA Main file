setup_imgt_normalisation() {
    header "STEP 5 · IMGT/HLA Normalisation"
    divider
    echo -e "  ${CYAN}OptiType, arcasHLA, and HLA-HD each bundle a different IMGT/HLA${RESET}"
    echo -e "  ${CYAN}database release internally.  The same allele can carry a different${RESET}"
    echo -e "  ${CYAN}4-field designation across releases, causing false discordances in${RESET}"
    echo -e "  ${CYAN}the consensus engine.  This stage rewrites all allele files to a${RESET}"
    echo -e "  ${CYAN}single canonical IMGT release using py-ard (NMDP Bio Solutions).${RESET}"
    echo ""
    echo -e "  ${BOLD}Requires:${RESET}  pip install py-ard"
    echo -e "  ${BOLD}Default:${RESET}   IMGT/HLA 3.51.0  (version code: 3510)"
    echo ""

    # Check whether py-ard is available right now.
    # The package installs as "pyard" (import pyard) in newer releases
    # and as "ard" (import ard) in older ones — try both.
    # Also verify it is importable in the exact python3 on PATH,
    # since conda/venv environments can shadow the system python.
    local _pyard_ok=false _pyard_ver="unknown" _pyard_module=""
    local _py; _py=$(command -v python3 2>/dev/null || echo "python3")
    if "$_py" -c "import pyard; print(pyard.__version__)" 2>/dev/null; then
        _pyard_ok=true
        _pyard_module="pyard"
        _pyard_ver=$("$_py" -c "import pyard; print(pyard.__version__)" 2>/dev/null || echo "unknown")
    elif "$_py" -c "import ard; print(ard.__version__)" 2>/dev/null; then
        _pyard_ok=true
        _pyard_module="ard"
        _pyard_ver=$("$_py" -c "import ard; print(ard.__version__)" 2>/dev/null || echo "unknown")
    fi
    if [[ "$_pyard_ok" == true ]]; then
        echo -e "  ${GREEN}✓ py-ard is installed (module: ${_pyard_module}, version: ${_pyard_ver})${RESET}"
        echo -e "  ${GREEN}  Python: ${_py}${RESET}"
    else
        echo -e "  ${YELLOW}⚠  py-ard not found for: ${_py}${RESET}"
        echo -e "  ${YELLOW}   Tried: import pyard  and  import ard — both failed.${RESET}"
        echo -e "  ${YELLOW}   Install with:  pip install py-ard${RESET}"
        echo -e "  ${YELLOW}   If using conda: conda install -c bioconda py-ard${RESET}"
        echo -e "  ${YELLOW}   Make sure you install into the same environment as python3${RESET}"
        echo -e "  ${CYAN}   Active python3: ${_py}${RESET}"
        echo -e "  ${CYAN}   To verify: ${_py} -c 'import pyard; print(pyard.__version__)'${RESET}"
        echo -e "  ${YELLOW}   Normalisation will be skipped at runtime if still absent.${RESET}"
    fi
    echo ""

    read -rp "$(echo -e "${BOLD}  → IMGT/HLA version to target [${IMGT_HLA_VERSION}]: ${RESET}")" _imgt_ver || true
    if [[ -n "$_imgt_ver" ]]; then
        # Accept both dotted (3.51.0) and compact (3510) formats
        # Compact format: strip dots and leading zeros per field → e.g. 3.51.0 → 3510
        if [[ "$_imgt_ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            local maj min pat
            IFS='.' read -r maj min pat <<< "$_imgt_ver"
            IMGT_HLA_VERSION="${maj}${min}${pat}"
            echo -e "  ${GREEN}✓ Converted dotted version ${_imgt_ver} → compact code ${IMGT_HLA_VERSION}${RESET}"
        else
            IMGT_HLA_VERSION="$_imgt_ver"
        fi
    fi
    echo -e "  ${GREEN}✓ IMGT/HLA version set: ${IMGT_HLA_VERSION}${RESET}"
    echo -e "  ${CYAN}  All per-tool allele files will be normalised to this release${RESET}"
    echo -e "  ${CYAN}  before QC and pVACtools formatting.  Original files are backed${RESET}"
    echo -e "  ${CYAN}  up with a .prenorm suffix in the output directory.${RESET}\n"
    audit_entry "IMGT_VERSION_SET" "version=${IMGT_HLA_VERSION}" "mode=interactive"
}

