_collect_arcasHLA_install() {
    # If hardcoded path is missing, try to find arcasHLA inside the conda env
    if [[ ! -f "$ARCASHLA_DIR/arcasHLA" ]]; then
        warn "arcasHLA not found at $ARCASHLA_DIR — searching conda env '${ARCASHLA_ENV}'..."
        local conda_base; conda_base=$(conda info --base 2>/dev/null)
        local env_bin="${conda_base}/envs/${ARCASHLA_ENV}/bin"
        if [[ -f "${env_bin}/arcasHLA" ]]; then
            ARCASHLA_DIR="/home/aboudreau/arcasHLA"
            info "arcasHLA auto-detected at: $ARCASHLA_DIR"
        else
            local found; found=$(find "$HOME" /research /opt \
                -name "arcasHLA" -type f 2>/dev/null | head -n 1 || true)
            if [[ -n "$found" ]]; then
                ARCASHLA_DIR="/home/aboudreau/arcasHLA"
                info "arcasHLA auto-detected at: $ARCASHLA_DIR"
            else
                error "arcasHLA not found. Set ARCASHLA_DIR at the top of the script or install: conda install -n ${ARCASHLA_ENV} -c bioconda arcashla"
            fi
        fi
    fi
    if ! conda env list | grep -q "^${ARCASHLA_ENV}"; then
        error "conda env '$ARCASHLA_ENV' not found. Run: conda create -n $ARCASHLA_ENV ..."
    fi
    echo -e "  ${GREEN}✓ arcasHLA found: $ARCASHLA_DIR${RESET}"
    echo -e "  ${GREEN}✓ conda env: $ARCASHLA_ENV${RESET}"
}

_collect_hlahd_install() {
    # Verify hlahd.sh binary exists
    if [[ ! -f "$HLAHD_DIR/bin/hlahd.sh" ]]; then
        local found; found=$(find "$HOME" /research /opt \
            -name "hlahd.sh" -type f 2>/dev/null | head -n 1 || true)
        if [[ -n "$found" ]]; then
            HLAHD_DIR="$(dirname "$(dirname "$found")")"
            info "HLA-HD auto-detected at: $HLAHD_DIR"
        else
            error "HLA-HD not found at $HLAHD_DIR/bin/hlahd.sh — set HLAHD_DIR at the top of the script."
        fi
    fi
    # Verify dictionary has bowtie2 indexes
    if [[ ! -d "$HLAHD_DICT_DIR" ]]; then
        error "HLA-HD dictionary not found at $HLAHD_DICT_DIR — set HLAHD_DICT_DIR at the top of the script."
    fi
    local bt2_count; bt2_count=$(find "$HLAHD_DICT_DIR" -name "*.bt2" 2>/dev/null | wc -l)
    if [[ "$bt2_count" -eq 0 ]]; then
        error "HLA-HD dictionary at $HLAHD_DICT_DIR has no .bt2 index files — run build_hlahd_index.sh first."
    fi
    # Verify freq_data exists
    if [[ ! -d "$HLAHD_FREQ_DIR" ]]; then
        error "HLA-HD freq_data not found at $HLAHD_FREQ_DIR — set HLAHD_FREQ_DIR at the top of the script."
    fi
    echo -e "  ${GREEN}✓ HLA-HD found: $HLAHD_DIR/bin/hlahd.sh${RESET}"
    echo -e "  ${GREEN}✓ Dictionary: $HLAHD_DICT_DIR (${bt2_count} .bt2 indexes)${RESET}"
    echo -e "  ${GREEN}✓ Freq data: $HLAHD_FREQ_DIR${RESET}"
}

