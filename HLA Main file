_collect_and_ensure_fastq() {
    local ctx="$1"
    echo -e "\n  ${BOLD}${ctx} · Input File${RESET}"
    echo -e "  Provide your file in ${BOLD}any${RESET} supported format:"
    echo -e "  .fastq  .fastq.gz  .fa  .fasta  .bam  .cram  .sam  .sra"
    echo -e "  ${YELLOW}  Incompatible formats will be converted automatically.${RESET}\n"
    local raw; raw=$(prompt_file "Input file path (Read 1 or single-end)")
    ensure_fastq "$raw" "$ctx"
    # Resolve to absolute path immediately
    [[ -n "$INPUT_R1" ]] && INPUT_R1="$(realpath "$INPUT_R1" 2>/dev/null || echo "$INPUT_R1")"

    if [[ -z "$INPUT_R2" ]]; then
        local r2; r2=$(prompt_file "Read 2 / paired-end file (optional — Enter to skip)" true)
        if [[ -n "$r2" ]]; then
            local r2fmt; r2fmt=$(detect_format "$r2")
            if [[ "$r2fmt" == "fastq" || "$r2fmt" == "fastq_gz" ]]; then
                INPUT_R2="$(realpath "$r2" 2>/dev/null || echo "$r2")"
            else
                local saved="$INPUT_R1"
                ensure_fastq "$r2" "$ctx R2"
                INPUT_R2="$INPUT_R1"; INPUT_R1="$saved"
            fi
        fi
    fi
}

_collect_and_ensure_bam() {
    local ctx="$1"
    echo -e "\n  ${BOLD}${ctx} · Input File${RESET}"
    echo -e "  Provide your file in ${BOLD}any${RESET} supported format:"
    echo -e "  .bam  .cram  .sam  .fastq  .fastq.gz  .fa  .fasta"
    echo -e "  ${YELLOW}  Incompatible formats will be aligned/converted automatically.${RESET}\n"
    local raw; raw=$(prompt_file "Input file path")
    ensure_bam "$raw" "$ctx"
}

